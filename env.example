# EduMaster Backend Environment Configuration

# Application Settings
DEBUG=true
ENVIRONMENT=development
SECRET_KEY=your-secret-key-here-change-in-production-make-it-long-and-random

# API Configuration
PORT=8010
CORS_ORIGINS=["http://localhost:5174", "http://127.0.0.1:5174"]
ALLOWED_HOSTS=*

# PostgreSQL Database Configuration (with pgvector extension)
DATABASE_URL=postgresql://postgres:password@localhost:5432/edumaster_db

# Google GenAI Configuration
GOOGLE_API_KEY=your-google-api-key
GOOGLE_EMBEDDING_MODEL=text-embedding-004
GOOGLE_LLM_MODEL=gemini-1.5-pro

# Redis Configuration
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# File Upload Configuration
MAX_FILE_SIZE=52428800
ALLOWED_FILE_TYPES=["pdf", "pptx", "docx", "png", "jpg", "jpeg"]
UPLOAD_PATH=uploads

# OCR Configuration
TESSERACT_PATH=
USE_GOOGLE_VISION=false
GOOGLE_VISION_CREDENTIALS=

# RAG Configuration
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
MAX_RETRIEVED_CHUNKS=5
SIMILARITY_THRESHOLD=0.7

# Security Configuration (JWT)
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# Celery Configuration
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Monitoring
SENTRY_DSN=
ENABLE_METRICS=true

# OCR - Mistral
MISTRAL_API_KEY=your-mistral-api-key

# ChromaDB Configuration
CHROMA_DB_PATH=chroma_db

