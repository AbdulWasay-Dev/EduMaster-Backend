# =============================================================================
# EduMaster Backend – Docker environment template
# =============================================================================
# Copy this file to .env.docker and fill in the real values.
# This file is loaded by docker-compose.yml (env_file: .env.docker).
# NEVER commit .env.docker to version control.
# =============================================================================

# ── Application ───────────────────────────────────────────────────────────────
DEBUG=false
ENVIRONMENT=production
SECRET_KEY=CHANGE_ME_use_a_long_random_string_here
PORT=8010

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=["https://your-frontend-domain.com"]

# ── PostgreSQL (external) ─────────────────────────────────────────────────────
# Supplied by your cloud database (Railway, Supabase, Neon, etc.)
DATABASE_URL=postgresql://user:password@your-postgres-host:5432/edu_master

# ── Redis (external) ──────────────────────────────────────────────────────────
# Supplied by your cloud Redis (Railway, Upstash, Redis Cloud, etc.)
REDIS_URL=redis://:password@your-redis-host:6379
REDIS_PASSWORD=

# Celery uses the same Redis instance
CELERY_BROKER_URL=redis://:password@your-redis-host:6379/0
CELERY_RESULT_BACKEND=redis://:password@your-redis-host:6379/0

# ── AI / LLM APIs ─────────────────────────────────────────────────────────────
GROQ_API_KEY=your-groq-api-key
# Optionally supply multiple Groq keys (comma-separated) for round-robin
GROQ_API_KEYS=key1,key2,key3
GROQ_LLM_MODEL=llama-3.3-70b-versatile

GOOGLE_API_KEY=your-google-api-key
MISTRAL_API_KEY=your-mistral-api-key

# ── OCR ───────────────────────────────────────────────────────────────────────
# Tesseract is bundled inside the container — path is fixed
TESSERACT_PATH=/usr/bin/tesseract
USE_GOOGLE_VISION=false
GOOGLE_VISION_CREDENTIALS=

# ── ChromaDB (inside container, persisted via named volume) ───────────────────
CHROMA_DB_PATH=/app/chroma_db

# ── Uploads (inside container, persisted via named volume) ────────────────────
UPLOAD_PATH=/app/uploads
MAX_FILE_SIZE=52428800
ALLOWED_FILE_TYPES=["pdf", "pptx", "docx", "png", "jpg", "jpeg"]

# ── Local Embedding Model (baked into image, runs offline) ────────────────────
LOCAL_EMBEDDING_MODEL=BAAI/bge-base-en-v1.5

# ── RAG ───────────────────────────────────────────────────────────────────────
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
MAX_RETRIEVED_CHUNKS=5
SIMILARITY_THRESHOLD=0.7

# ── JWT ───────────────────────────────────────────────────────────────────────
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# ── Monitoring (optional) ─────────────────────────────────────────────────────
SENTRY_DSN=
ENABLE_METRICS=true
