# CI-friendly production image for GitHub Actions.
# The regular Dockerfile pre-builds wheels and bakes the embedding model into
# the image. That is nicer for cold starts, but too disk-heavy for GitHub's
# hosted runner. This file keeps all backend features while using much less
# temporary build storage.

FROM python:3.11-slim-bookworm

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONPATH=/app \
    ENVIRONMENT=production \
    DEBUG=false \
    PORT=8010 \
    ALLOWED_HOSTS=* \
    TESSERACT_PATH=/usr/bin/tesseract \
    USE_GOOGLE_VISION=false \
    CHROMA_DB_PATH=/app/chroma_db \
    UPLOAD_PATH=/app/uploads \
    LOCAL_EMBEDDING_MODEL=BAAI/bge-base-en-v1.5 \
    HF_HOME=/app/.cache/huggingface \
    TORCH_HOME=/app/.cache/torch \
    TRANSFORMERS_OFFLINE=0

RUN set -eux; \
    apt-get update; \
    apt-get install -y --no-install-recommends \
        build-essential \
        gcc \
        g++ \
        git \
        curl \
        ca-certificates \
        libpq-dev \
        libffi-dev \
        libssl-dev \
        tesseract-ocr \
        tesseract-ocr-eng \
        tesseract-ocr-urd \
        libglib2.0-0 \
        libsm6 \
        libxext6 \
        libxrender-dev \
        libgl1-mesa-glx \
        libfreetype6 \
        libjpeg62-turbo \
        libpng16-16 \
        libpq5 \
        tini; \
    rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY requirements.txt .

RUN set -eux; \
    pip install --upgrade pip setuptools wheel; \
    pip install --no-cache-dir -r requirements.txt; \
    apt-get purge -y --auto-remove build-essential gcc g++ git libpq-dev libffi-dev libssl-dev; \
    rm -rf /root/.cache/pip /tmp/* /var/tmp/*

RUN groupadd --gid 1001 appgroup && \
    useradd --uid 1001 --gid appgroup --shell /bin/bash --create-home appuser

COPY --chown=appuser:appgroup . .

RUN mkdir -p /app/uploads \
             /app/chroma_db \
             /app/static \
             /app/logs \
             /app/.cache/huggingface \
             /app/.cache/torch && \
    chown -R appuser:appgroup /app

EXPOSE 8010

USER appuser

HEALTHCHECK --interval=30s --timeout=15s --start-period=120s --retries=5 \
    CMD curl -f http://localhost:${PORT:-8010}/health || exit 1

ENTRYPOINT ["/usr/bin/tini", "--"]

CMD sh -c "uvicorn main:app \
    --host 0.0.0.0 \
    --port ${PORT:-8010} \
    --workers 1 \
    --loop uvloop \
    --http httptools \
    --log-level info"
